<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="icon" type="image/x-icon" href="/src/favicon.ico">
    <link rel="stylesheet" href="/styles/<%= stylesheet || 'home' %>.css">
</head>

<body>
    <% if (isLogged || isLogged===false) { %>
        <nav class="navbar">
            <div class="nav-container">
                <a href="/home" class="logo" style="text-decoration: none; color: inherit;">CryptoCampus</a>
                <div class="nav-links">
                    <a href="/home" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">Requêtes</a>
                    <a href="/balance" class="nav-link <%= currentPage === 'balance' ? 'active' : '' %>">Mon solde</a>
                    <a href="/shop" class="nav-link <%= currentPage === 'shop' ? 'active' : '' %>">Boutique</a>
                    <a href="/create_request"
                        class="nav-link btn-create <%= currentPage === 'create_request' ? 'active' : '' %>">Créer une
                        requête</a>
                    <button id="loginBtn" class="btn-login">Connexion</button>
                </div>
            </div>
        </nav>
        <% } %>

            <%- body %>

                <script src="/js/logout.js"></script>
</body>

</html>