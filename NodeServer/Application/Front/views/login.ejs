<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CryptoCampus - Connexion</title>
    <link rel="icon" type="image/x-icon" href="/src/favicon.ico">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/login.css">
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <a href="/home" class="logo">CryptoCampus</a>
            <div class="nav-links">
                <a href="/home" class="nav-link">Requêtes</a>
                <a href="/balance" class="nav-link">Mon solde</a>
                <a href="/shop" class="nav-link">Boutique</a>
                <a href="/create_request" class="nav-link btn-create">Créer une requête</a>
                <button id="loginBtn" class="btn-login">Connexion</button>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="card">
            <h1>CryptoCampus</h1>
            <p class="subtitle">Plateforme d'entraide étudiante</p>

            <div class="form-container">
                <div class="tabs">
                    <button class="tab active" data-tab="login">Connexion</button>
                    <button class="tab" data-tab="register">Créer un compte</button>
                </div>

                <!-- Formulaire de connexion -->
                <form id="loginForm" class="form active">
                    <div class="form-group">
                        <label for="loginEmail">Email</label>
                        <input type="email" id="loginEmail" placeholder="email@exemple.com" required>
                    </div>
                    <div class="form-group">
                        <label for="loginPassword">Mot de passe</label>
                        <input type="password" id="loginPassword" placeholder="Votre mot de passe" required>
                    </div>
                    <button type="submit" class="btn-primary">Se connecter</button>
                </form>

                <!-- Formulaire d'inscription -->
                <form id="registerForm" class="form">
                    <div class="form-group">
                        <label for="registerName">Nom complet</label>
                        <input type="text" id="registerName" placeholder="Votre nom" required>
                    </div>
                    <div class="form-group">
                        <label for="registerEmail">Email</label>
                        <input type="email" id="registerEmail" placeholder="email@exemple.com" required>
                    </div>
                    <div class="form-group">
                        <label for="registerPassword">Mot de passe</label>
                        <input type="password" id="registerPassword" placeholder="Choisir un mot de passe" required>
                    </div>
                    <button type="submit" class="btn-primary">Créer mon compte</button>
                </form>
            </div>
        </div>
    </div>
    <script src="/js/auth-check.js"></script>
    <script src="/js/login.js"></script>
    <script src="/js/logout.js"></script>
</body>

</html>