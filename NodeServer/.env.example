COMPOSE_PROJECT_NAME=node-server

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=CryptoCampus

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

DB_HOST=db
DB_NAME=CryptoCampus
DB_USER=changeme
DB_PASSWORD=changeme
SQL_FILE=../Docker/PgAdmin/DB_Backup/CryptoCampusProMax2.sql

# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=changeme

# Chiffrement des clés privées des wallets générés pour chaque utilisateur (32 octets hex).
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=changeme

# Connexion via LinkedIn (OAuth 2.0 / OpenID Connect)
# A obtenir sur https://www.linkedin.com/developers/apps en activant le produit
# "Sign In with LinkedIn using OpenID Connect" et en déclarant l'URL de redirection ci-dessous
LINKEDIN_CLIENT_ID=changeme
LINKEDIN_CLIENT_SECRET=changeme
LINKEDIN_REDIRECT_URI=http://localhost:80/api/auth/linkedin/callback

# A obtenir sur https://console.mistral.ai/
MISTRAL_API_KEY=changeme

# Origines autorisées à appeler l'API en cross-origin avec cookies (séparées par des virgules)
# http://localhost:5000 / 127.0.0.1:5000 : app mobile Flutter en dev (flutter run -d chrome --web-port=5000)
FRONTEND_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5000,http://127.0.0.1:5000
