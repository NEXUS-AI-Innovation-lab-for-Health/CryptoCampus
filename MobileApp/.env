# Configuration de l'API
# Pour Android Emulator, utiliser 10.0.2.2 au lieu de localhost
# Pour un appareil physique, utiliser l'IP locale de votre machine (ex: 192.168.x.x)
# Cible de dev actuelle : flutter run -d chrome --web-port=5000 (même machine que Docker)
#
# IMPORTANT (web) : utiliser "localhost" ici, PAS "127.0.0.1". Le cookie de session a
# SameSite=Lax ; pour un navigateur "localhost" et "127.0.0.1" sont des sites DIFFÉRENTS
# (même si ça pointe sur la même machine), donc le cookie ne serait jamais renvoyé si l'un
# des deux (app Flutter ou API) utilise 127.0.0.1 et l'autre localhost. Chrome ouvre l'app
# Flutter sur localhost:<web-port> : l'API doit donc être appelée en localhost elle aussi.

API_BASE_URL=http://localhost:81
WEB_APP_URL=http://localhost:80
